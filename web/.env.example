# ---- database ----
DATABASE_URL="postgresql://bingo:bingo@localhost:5433/bingo?schema=public"

# ---- access ----
# Corporate email only. Separate several domains with commas.
ALLOWED_EMAIL_DOMAINS="effective-soft.com"
# Who gets the HR area on first sign-in (comma separated). After that, roles live in the database.
HR_EMAILS="hr@effective-soft.com"
# Session lifetime in days. It needs to be long, or every visit from a phone means another email.
SESSION_DAYS="90"
# Secret used to sign and hash tokens. Generate one with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-random-string"
# Public address of the app. Links in outgoing email are built from it.
APP_URL="http://localhost:3000"

# ---- mail ----
# With SMTP_HOST empty no mail is sent: the sign-in link is printed to the console instead
# and shown on the sign-in page. Development only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Bingo <bingo@effective-soft.com>"

# ---- proof storage ----
# local — a folder on disk (development), s3 — any S3-compatible bucket (production).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.uploads"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="bingo-proofs"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ---- other ----
# Time zone the daily cell limit is measured in.
ROUND_TIMEZONE="Europe/Minsk"

# DEBUG: opens the HR area to everyone signed in. Remove before production.
DEBUG_OPEN_HR="false"
