# Copy to deploy/.env and fill in. docker compose reads it automatically.

# The public hostname. Caddy requests a certificate for exactly this name,
# so it must already resolve to this host and ports 80/443 must be reachable.
DOMAIN=bingo.example.com
# The address people actually reach the app on. Sign-in links are built from it
# and so is the redirect after one is clicked, the session cookie is marked
# Secure only when it starts with https, and the link preview that Teams,
# Telegram and Slack unfurl points its image here. Behind a proxy the app cannot
# work this out for itself: the request it sees arrives from the Docker bridge.
APP_URL=https://bingo.example.com

# openssl rand -hex 32
AUTH_SECRET=
# openssl rand -base64 24
POSTGRES_PASSWORD=

ALLOWED_EMAIL_DOMAINS=effective-soft.com
HR_EMAILS=hr@effective-soft.com
SESSION_DAYS=90

# Corporate mail. Without it nobody can sign in: the magic link has no way out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Bingo <bingo@effective-soft.com>

ROUND_TIMEZONE=Europe/Minsk

# Leave false in production. True opens the HR area to everyone signed in.
DEBUG_OPEN_HR=false
